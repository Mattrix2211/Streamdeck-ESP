# Copiez ce fichier en "config.yaml" (ignore par git) et adaptez-le.

connection:
  # IP ou nom mDNS (ex: streamdeck.local) du Stream Deck sur le reseau
  host: "streamdeck.local"
  port: 6053
  # Meme valeur que "api_encryption_key" dans firmware/secrets.yaml
  api_encryption_key: "REMPLACER_PAR_LA_MEME_CLE_QUE_LE_FIRMWARE"

# Mapping evenement -> action locale. Les cles de premier niveau doivent
# correspondre EXACTEMENT aux "name:" des entites event: dans streamdeck.yaml.
actions:
  "Bouton d'action ecran":
    action_1: { type: launch, target: "notepad.exe" }
    action_2: { type: url, target: "https://www.home-assistant.io" }
    action_3: { type: keys, target: ["ctrl", "shift", "s"] }
    action_4: { type: media, target: "play_pause" }
    action_5: { type: media, target: "next" }
    action_6: { type: media, target: "mute" }

  "Encodeur 1 - evenement":
    clockwise: { type: media, target: "vol_up" }
    anticlockwise: { type: media, target: "vol_down" }
    press: { type: media, target: "mute" }

  "Encodeur 2 - evenement":
    clockwise: { type: keys, target: ["ctrl", "="] }
    anticlockwise: { type: keys, target: ["ctrl", "-"] }
    press: { type: launch, target: "explorer.exe" }

  "Encodeur 3 - evenement":
    clockwise: { type: keys, target: ["right"] }
    anticlockwise: { type: keys, target: ["left"] }
    press: { type: keys, target: ["space"] }
