# A coller dans l'add-on "ESPHome Builder" de Home Assistant (bouton
# "Editer" sur votre appareil, vue editeur de code), a la place du contenu
# existant. Contrairement a streamdeck.yaml (usage CLI), ce fichier
# recupere firmware/package.yaml directement depuis GitHub a chaque
# compilation : vous n'avez rien d'autre a coller ni a mettre a jour a la
# main, il suffit de cliquer "Installer"/"Mettre a jour" dans HA.
#
# Adaptez les valeurs ci-dessous a votre reseau, puis gardez ce fichier tel
# quel pour les prochaines mises a jour (je pousse mes changements sur
# GitHub, vous n'avez qu'a recompiler).

substitutions:
  name: "stream-deck"
  friendly_name: "Stream Deck"
  room: "Bureau"

esphome:
  name: ${name}
  friendly_name: ${friendly_name}

esp32:
  variant: esp32p4
  # Necessaire si votre carte est un exemplaire d'ingenierie pre-serie
  # (revision de silicium < v3.0) - c'etait votre cas sur l'ancien repo :
  engineering_sample: true

logger:

wifi:
  ssid: "REMPLACER_PAR_VOTRE_SSID"
  password: "REMPLACER_PAR_VOTRE_MOT_DE_PASSE_WIFI"

# Generez une cle avec (terminal HA, add-on "Terminal & SSH", ou sur votre PC) :
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api:
  encryption:
    key: "REMPLACER_PAR_UNE_CLE_BASE64_32_OCTETS"

ota:
  - platform: esphome
    password: "REMPLACER_PAR_UN_MOT_DE_PASSE_OTA"

# Recupere tout le hardware + l'UI depuis GitHub a chaque compilation.
# `ref:` pointe la branche de dev actuelle - a changer pour "main" une fois
# le travail merge si vous voulez suivre la branche stable a la place.
packages:
  hardware_and_ui:
    url: https://github.com/Mattrix2211/Streamdeck-ESP
    file: firmware/package.yaml
    ref: claude/stream-deck-pc-home-assistant-7l8pc9
    refresh: 0s
